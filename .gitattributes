* text=auto eol=lf
release/public-source.json linguist-generated=true
release/dependency-licenses.json linguist-generated=true
tsconfig.standalone.json linguist-generated=true
*.gz -text
*.jar -text
*.exe -text
*.png -text
*.jpg -text
*.jpeg -text
*.woff2 -text
*.pdf -text
*.gif -text
*.mp4 -text
# Binary payloads shipped with the desktop client (wasm kernels, fonts, native
# modules, installer assets); never normalize their bytes.
*.wasm -text
*.br -text
*.bcmap -text
*.ttf -text
*.woff -text
*.node -text
*.dll -text
*.pfb -text
*.icns -text
*.ico -text
*.dat -text
*.bin -text
*.pak -text
# Prebuilt desktop-client content is a byte-for-byte recovery of the shipped
# build (renderer bundles, resources, vendored runtime snapshots); it must not
# be line-ending normalized. Restored sources under apps/electron/main keep the
# repository's LF normalization.
apps/electron/out/** -text
apps/electron/public/** -text
apps/electron/model-menu/** -text
apps/electron/resources/** -text
apps/electron/vendor/** -text
# Preserve vendored Office schema bytes when importing the reviewed source archive.
packages/local-runtime/assets/skills/xlsx/scripts/office/schemas/**/*.xsd -text
