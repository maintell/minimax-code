+    // official | user | dev 分组进程是否在运行。
+    3: optional bool host_running
+    255: optional base_rpc.BaseResp base_resp
+}
+
+// 导出用户/开发包当前运行内容为 zip；再次导入得到相同摘要。target 为绝对路径且以 .zip 结尾。
+struct ExportModelAccessPackageReq {
