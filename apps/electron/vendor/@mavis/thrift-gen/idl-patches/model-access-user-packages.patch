 }
 
@@ -186,13 +247,90 @@ struct PreviewModelAccessPackageResp {
 }
 
 // 信任是对确切内容摘要的同意；摘要变化时拒绝导入。新增能力不默认开启。
+// 安装为用户包（user 分组），启用后运行于用户分组进程；@mavis/* 名称保留给官方包。
 struct ImportModelAccessPackageReq {
     1: required string source (api.body="source")
     2: required string expected_digest (api.body="expected_digest")
