+struct ModelAccessPackageSource {
+    1: required string kind
+    2: required string path
+}
+
 // 预览不导入代码、不执行扩展；只返回内容摘要和声明的能力。
+// source_ref 优先；只给 source 时按路径推断（.zip 为压缩包，否则为文件夹）。
 struct PreviewModelAccessPackageReq {
