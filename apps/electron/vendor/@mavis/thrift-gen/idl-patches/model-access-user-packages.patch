+struct ApproveModelAccessDevRequestReq {
+    1: required string request_id (api.body="request_id")
+    2: required string expected_digest (api.body="expected_digest")
+    3: required bool trust_native_code (api.body="trust_native_code")
+    255: optional base_rpc.BaseReq base_req (api.none="")
+}
+
+struct DismissModelAccessDevRequestReq {
+    1: required string request_id (api.body="request_id")
+    255: optional base_rpc.BaseReq base_req (api.none="")
+}
+
+struct ModelAccessDevSessionReq {
+    1: required string session_id (api.body="session_id")
+    255: optional base_rpc.BaseReq base_req (api.none="")
+}
+
+struct ModelAccessDevSessionResp {
+    1: required ModelAccessDevSession session
+    2: required ModelAccessSnapshot snapshot
+    255: optional base_rpc.BaseResp base_resp
+}
+
+// 转正：用户同意当前开发内容（expected_digest）作为用户包长期运行。
+struct PromoteModelAccessDevSessionReq {
+    1: required string session_id (api.body="session_id")
+    2: required string expected_digest (api.body="expected_digest")
+    3: required bool trust_native_code (api.body="trust_native_code")
+    255: optional base_rpc.BaseReq base_req (api.none="")
+}
+
+// 只读诊断：加载状态与 provider/登录方式，不含凭据、token 或扩展日志原文。
+struct GetModelAccessExtensionStatusReq {
+    1: required string installation_id (api.body="installation_id")
     255: optional base_rpc.BaseReq base_req (api.none="")
 }
 
+struct ModelAccessExtensionProbe {
+    1: required string provider_id
+    2: required list<string> methods
+    // 公共 provider 可列出的模型 id；需要登录的 provider 为空。
+    3: optional list<string> models
+    4: optional string error_code
+}
+
+struct GetModelAccessExtensionStatusResp {
+    1: required ModelAccessInstallationInfo installation
