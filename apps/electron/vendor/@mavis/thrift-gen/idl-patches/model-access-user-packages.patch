+    4: optional ModelAccessPackageSource source_ref (api.body="source_ref")
+    255: optional base_rpc.BaseReq base_req (api.none="")
+}
+
+// 开始开发会话：trust_native_code 表示用户同意在本次会话内运行 path 下的包。
+struct StartModelAccessDevSessionReq {
+    1: required string path (api.body="path")
