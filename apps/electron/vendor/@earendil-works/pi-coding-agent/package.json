{
  "name": "@earendil-works/pi-coding-agent",
  "version": "0.79.1",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "type": "module",
  "piConfig": {
    "configDir": ".pi"
  },
  "bin": {
    "pi": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./tools": {
      "import": "./dist/core/tools/index.js"
    },
    "./messages": {
      "import": "./dist/core/messages.js"
    },
    "./auth-storage": {
      "import": "./dist/core/auth-storage.js"
    },
    "./compaction": {
      "import": "./dist/core/compaction/compaction.js"
    },
    "./image-resize": {
      "import": "./dist/utils/image-resize.js"
    },
    "./shell": {
      "import": "./dist/utils/shell.js"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../pi-agent-core",
    "@earendil-works/pi-ai": "file:../pi-ai",
    "@earendil-works/pi-tui": "file:../pi-tui",
    "@silvia-odwyer/photon-node": "0.3.4",
    "chalk": "5.6.2",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "glob": "13.0.6",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "minimatch": "10.2.6",
    "proper-lockfile": "4.1.2",
    "typebox": "1.1.38",
    "undici": "8.10.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "file:../../@mariozechner/clipboard"
  },
  "author": "Mario Zechner",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
